{
  "version": 3,
  "configurePresets": [
    {
      "name": "linux-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [{"name": "linux-debug", "configurePreset": "linux-debug"}],
  "testPresets": [{"name": "linux-debug", "configurePreset": "linux-debug", "output": {"outputOnFailure": true}}]
}
